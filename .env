# 게시글 등록 API의 전체 주소를 입력한 뒤 이 파일을 .env로 복사하세요.
VITE_BOARD_WRITE_API_URL=/api/community/posts

# 기능이 완성되기 테스트에 사용할 실제 사용자 ID입니다.

# 산책 API의 공통 시작 주소입니다. 백엔드 주소가 바뀌면 이 값만 수정하세요.
VITE_WALK_API_URL=/api/walks

# 백엔드 장소 API의 공통 주소입니다.
VITE_PLACE_API_URL=/api/places

# 카카오 Developers의 JavaScript 키를 등호 오른쪽에 붙여 넣으세요.
VITE_KAKAO_MAP_JAVASCRIPT_KEY= 3a869403a9e57d7d52fce249034e086f
VITE_KAKAO_MAP_KEY= 3a869403a9e57d7d52fce249034e086f