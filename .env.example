# 이 파일을 .env로 복사한 뒤 프로젝트 환경에 맞게 값을 수정합니다.
VITE_BOARD_WRITE_API_URL=/api/community/posts
VITE_WALK_API_URL=/api/walks

# 카카오 로그인을 처리하는 백엔드 주소입니다.
VITE_API_ORIGIN=http://localhost:8080

# 카카오 Developers에서 발급한 JavaScript 키를 넣습니다. REST API 키가 아닙니다.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# 백엔드 장소 API의 공통 주소입니다.
VITE_PLACE_API_URL=/api/places
